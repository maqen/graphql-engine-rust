{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "tables": [
        {
          "table": {
            "name": "article",
            "schema": "public"
          },
          "object_relationships": [
            {
              "name": "author",
              "using": {
                "foreign_key_constraint_on": "author_id"
              }
            }
          ],
          "insert_permissions": [
            {
              "role": "user",
              "permission": {
                "check": {
                  "author_id": "X-Hasura-User-Id"
                }
              }
            }
          ],
          "select_permissions": [
            {
              "role": "anonymous",
              "permission": {
                "columns": [
                  "id",
                  "title",
                  "content",
                  "is_published"
                ],
                "filter": {
                  "is_published": true
                }
              }
            },
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "title",
                  "content",
                  "is_published"
                ],
                "filter": {
                  "_or": [
                    {
                      "author_id": "X-HASURA-USER-ID"
                    },
                    {
                      "is_published": true
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "author",
            "schema": "public"
          },
          "array_relationships": [
            {
              "name": "articles",
              "using": {
                "foreign_key_constraint_on": {
                  "column": "author_id",
                  "table": {
                    "name": "article",
                    "schema": "public"
                  }
                }
              }
            }
          ],
          "insert_permissions": [
            {
              "role": "user",
              "permission": {
                "check": {
                  "id": "X-HASURA-USER-ID"
                }
              }
            }
          ],
          "select_permissions": [
            {
              "role": "anonymous",
              "permission": {
                "columns": [
                  "id",
                  "name"
                ],
                "filter": {
                  "articles": {
                    "is_published": {
                      "_eq": true
                    }
                  }
                }
              }
            },
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "name",
                  "is_registered"
                ],
                "filter": {
                  "_or": [
                    {
                      "id": "X-HASURA-USER-ID"
                    },
                    {
                      "articles": {
                        "is_published": {
                          "_eq": true
                        }
                      }
                    }
                  ]
                }
              }
            }
          ],
          "update_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": "*",
                "filter": {
                  "id": "X-HASURA-USER-ID"
                },
                "check": null
              }
            }
          ]
        }
      ],
      "configuration": {
        "connection_info": {
          "database_url": {
            "from_env": "HASURA_GRAPHQL_DATABASE_URL"
          },
          "isolation_level": "read-committed",
          "pool_settings": {
            "connection_lifetime": 600,
            "idle_timeout": 180,
            "max_connections": 50,
            "retries": 1
          },
          "use_prepared_statements": true
        }
      }
    }
  ]
}
