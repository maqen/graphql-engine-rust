{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "tables": [
        {
          "table": {
            "name": "profile",
            "schema": "public"
          },
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "name"
                ],
                "filter": {}
              }
            }
          ]
        }
      ],
      "functions": [
        {
          "function": {
            "name": "me",
            "schema": "public"
          },
          "configuration": {
            "custom_root_fields": {},
            "session_argument": "hasura_session"
          }
        }
      ],
      "configuration": {
        "connection_info": {
          "database_url": {
            "from_env": "HASURA_GRAPHQL_DATABASE_URL"
          },
          "isolation_level": "read-committed",
          "use_prepared_statements": false
        }
      }
    }
  ]
}
