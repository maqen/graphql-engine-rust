{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "tables": [
        {
          "table": {
            "name": "documents",
            "schema": "public"
          },
          "select_permissions": [
            {
              "role": "public_role",
              "permission": {
                "columns": [
                  "id",
                  "title",
                  "body",
                  "owner_id",
                  "is_private"
                ],
                "filter": {
                  "is_private": {
                    "_eq": false
                  }
                }
              }
            },
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "title",
                  "body",
                  "owner_id",
                  "is_private"
                ],
                "filter": {
                  "_or": [
                    {
                      "owner_id": "X-Hasura-User-Id"
                    },
                    {
                      "is_private": {
                        "_eq": false
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "users",
            "schema": "public"
          },
          "computed_fields": [
            {
              "name": "all_docs",
              "definition": {
                "function": {
                  "name": "user_all_documents",
                  "schema": "public"
                },
                "table_argument": "user_row"
              }
            }
          ],
          "select_permissions": [
            {
              "role": "public_role",
              "permission": {
                "columns": [
                  "id",
                  "name"
                ],
                "filter": {}
              }
            },
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "name"
                ],
                "filter": {}
              }
            }
          ]
        }
      ],
      "configuration": {
        "connection_info": {
          "database_url": {
            "from_env": "HASURA_GRAPHQL_DATABASE_URL"
          },
          "isolation_level": "read-committed",
          "use_prepared_statements": false
        }
      }
    }
  ]
}
