        "response_transform": {
          "body": {
            "action": "transform",
            "template": "{\n  \"uid\": {{ $body.user_id.id }},\n  \"city0\": {{ $body.addresses[0].city }},\n  \"country0\": {{ $body.addresses[0].country }},\n  \"other_addresses\":\n    {{ range i, x := $body.addresses }}\n      {{ if i > 0 }}\n        {\n          \"city\": {{ x.city }},\n          \"country\": {{ x.country }}\n        }\n      {{ else }}\n        null\n      {{ end }}\n    {{ end }}\n}\n"
          },
          "template_engine": "Kriti",
          "version": 2
        },
        "type": "query"
