          "table": {
            "name": "article",
            "schema": "public"
          }
        },
        {
          "table": {
            "name": "user",
            "schema": "public"
          },
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "name",
                  "email"
                ],
                "filter": {
                  "id": "X-Hasura-User-Id"
                }
              }
            }
          ]
        }
      ],
      "configuration": {
        "connection_info": {
          "database_url": {
            "from_env": "HASURA_GRAPHQL_DATABASE_URL"
          },
          "isolation_level": "read-committed",
          "use_prepared_statements": false
        }
      }
    }
