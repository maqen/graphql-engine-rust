{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "configuration": {
        "connection_info": {
          "database_url": {
            "from_env": "HASURA_GRAPHQL_DATABASE_URL"
          }
        }
      },
      "tables": [
        {
          "table": {
            "name": "qv_author",
            "schema": "public"
          },
          "array_relationships": [
            {
              "name": "articles",
              "using": {
                "foreign_key_constraint_on": {
                  "column": "author_id",
                  "table": {
                    "name": "qv_article",
                    "schema": "public"
                  }
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "qv_article",
            "schema": "public"
          }
        }
      ]
    }
  ]
}