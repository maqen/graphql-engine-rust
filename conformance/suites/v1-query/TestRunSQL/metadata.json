{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "tables": [
        {
          "table": {
            "name": "article",
            "schema": "public"
          },
          "object_relationships": [
            {
              "name": "author",
              "using": {
                "foreign_key_constraint_on": "author_id"
              }
            }
          ],
          "insert_permissions": [
            {
              "role": "user",
              "permission": {
                "check": {
                  "author_id": "X-Hasura-User-Id"
                }
              }
            },
            {
              "role": "user2",
              "permission": {
                "check": {},
                "columns": [
                  "id",
                  "title",
                  "content",
                  "author_id"
                ]
              }
            }
          ],
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "title",
                  "content",
                  "author_id"
                ],
                "filter": {
                  "author": {
                    "id": "X-Hasura-User-Id"
                  }
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "author",
            "schema": "public"
          },
          "array_relationships": [
            {
              "name": "articles",
              "using": {
                "foreign_key_constraint_on": {
                  "column": "author_id",
                  "table": {
                    "name": "article",
                    "schema": "public"
                  }
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "test",
            "schema": "public"
          },
          "insert_permissions": [
            {
              "role": "user",
              "permission": {
                "check": {
                  "id": "X-Hasura-User-Id"
                },
                "set": {
                  "bool_col": true
                },
                "columns": [
                  "id",
                  "name"
                ]
              }
            }
          ],
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "name"
                ],
                "filter": {
                  "bool_col": true,
                  "id": "X-Hasura-User-Id"
                }
              }
            }
          ]
        }
      ],
      "configuration": {
        "connection_info": {
          "database_url": {
            "from_env": "HASURA_GRAPHQL_DATABASE_URL"
          },
          "isolation_level": "read-committed",
          "use_prepared_statements": false
        }
      }
    }
  ]
}
