        },
        {
          "table": {
            "name": "items",
            "schema": "public"
          }
        },
        {
          "table": {
            "name": "leads",
            "schema": "public"
          },
          "insert_permissions": [
            {
              "role": "sales",
              "permission": {
                "check": {},
                "columns": [
                  "id",
                  "name",
                  "added_by"
                ]
              }
            }
          ],
          "update_permissions": [
            {
              "role": "sales",
              "permission": {
                "columns": [
                  "name"
                ],
                "filter": {
                  "added_by": "X-Hasura-User-Id"
                },
                "check": {
                  "name": {
                    "_ne": ""
                  }
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "order_cart",
            "schema": "public"
          },
          "object_relationships": [
            {
              "name": "item",
              "using": {
                "foreign_key_constraint_on": "item_id"
              }
            }
          ],
          "insert_permissions": [
            {
              "role": "user",
              "permission": {
                "check": {
                  "item": {
                    "item_quantity": {
                      "_cgte": [
                        "$",
                        "order_cart_quantity"
                      ]
                    }
                  }
                },
                "columns": [
                  "item_id",
                  "order_cart_quantity"
                ]
              }
            }
          ]
        },
        {
          "table": {
            "name": "resident",
            "schema": "public"
          },
          "insert_permissions": [
            {
              "role": "infant",
              "permission": {
                "check": {
                  "id": "X-Hasura-Infant-Id"
                },
                "set": {
                  "id": "X-Hasura-Infant-Id",
                  "name": "X-Hasura-Infant-Name"
                },
                "columns": [
                  "age"
                ]
              }
            },
            {
              "role": "resident",
              "permission": {
                "check": {
                  "id": "X-Hasura-Resident-Id"
                }
              }
            },
            {
              "role": "user",
              "permission": {
                "check": {
                  "id": "X-Hasura-Resident-Id"
                },
                "set": {
                  "is_user": true,
                  "name": "X-Hasura-Resident-Name"
                }
              }
            }
          ],
          "select_permissions": [
            {
              "role": "infant",
              "permission": {
                "columns": [
                  "id",
                  "name",
                  "age",
                  "is_user"
                ],
                "filter": {
                  "id": "X-Hasura-Infant-Id"
                }
              }
            },
            {
              "role": "resident",
              "permission": {
                "columns": "*",
                "filter": {
                  "id": "X-Hasura-Resident-Id"
                }
              }
            },
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "name",
                  "age",
                  "is_user"
                ],
                "filter": {
                  "id": "X-Hasura-Resident-Id"
                }
              }
            }
          ],
          "update_permissions": [
            {
              "role": "resident",
              "permission": {
                "columns": "*",
                "filter": {
                  "id": "X-Hasura-Resident-Id"
                },
                "check": null
              }
            }
          ]
        },
        {
