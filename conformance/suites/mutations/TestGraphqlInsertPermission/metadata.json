{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "tables": [
        {
          "table": {
            "name": "Company",
            "schema": "public"
          },
          "insert_permissions": [
            {
              "role": "user",
              "permission": {
                "check": {
                  "id": "X-HASURA-COMPANY-ID"
                }
              }
            }
          ],
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "name"
                ],
                "filter": {
                  "id": "X-HASURA-COMPANY-ID"
                }
              }
            }
          ],
          "update_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": "*",
                "filter": {
                  "id": "X-HASURA-COMPANY-ID"
                },
                "check": null
              }
            }
          ]
        },
        {
          "table": {
            "name": "account",
            "schema": "public"
          },
          "insert_permissions": [
            {
              "role": "user",
              "permission": {
                "check": {
                  "_exists": {
                    "_table": {
                      "name": "user",
                      "schema": "public"
                    },
                    "_where": {
                      "id": "X-Hasura-User-Id",
                      "is_admin": true
                    }
                  }
                },
                "columns": [
                  "account_no"
                ]
              }
            }
          ]
        },
        {
          "table": {
            "name": "address",
            "schema": "public"
          }
        },
        {
          "table": {
            "name": "article",
            "schema": "public"
          },
          "object_relationships": [
            {
              "name": "author",
              "using": {
                "foreign_key_constraint_on": "author_id"
              }
            }
          ],
          "insert_permissions": [
            {
              "role": "editor",
              "permission": {
                "check": {
                  "author_id": {
                    "$in": "X-Hasura-Allowed-User-Ids"
                  }
                }
              }
            },
            {
              "role": "restricted",
              "permission": {
                "check": {
                  "author_id": "X-Hasura-User-Id"
                }
              }
            },
            {
              "role": "user",
              "permission": {
                "check": {
                  "author_id": "X-Hasura-User-Id"
                }
              }
            }
          ],
          "select_permissions": [
            {
              "role": "editor",
              "permission": {
                "columns": "*",
                "filter": {
                  "_or": [
                    {
                      "author_id": {
                        "$in": "X-Hasura-Allowed-User-Ids"
                      }
                    },
                    {
                      "is_published": true
                    }
                  ]
                }
              }
            },
            {
              "role": "restricted",
              "permission": {
                "columns": "*",
                "filter": {
                  "_or": [
                    {
                      "author_id": "X-HASURA-USER-ID"
                    },
                    {
                      "is_published": true
                    }
                  ]
                }
              }
            },
            {
              "role": "user",
              "permission": {
                "columns": "*",
                "filter": {
                  "_or": [
                    {
                      "author_id": "X-HASURA-USER-ID"
                    },
                    {
                      "is_published": true
                    }
                  ]
                }
              }
            }
          ],
          "update_permissions": [
            {
              "role": "restricted",
              "permission": {
                "columns": [],
                "filter": {
                  "author_id": "X-Hasura-User-Id"
                },
                "check": null
              }
            },
            {
              "role": "user",
              "permission": {
                "columns": "*",
                "filter": {
                  "author_id": "X-Hasura-User-Id"
                },
                "check": null
              }
            }
          ]
        },
        {
          "table": {
            "name": "author",
            "schema": "public"
          },
          "array_relationships": [
            {
              "name": "articles",
              "using": {
                "foreign_key_constraint_on": {
                  "column": "author_id",
                  "table": {
                    "name": "article",
                    "schema": "public"
                  }
                }
              }
            }
          ],
          "computed_fields": [
            {
              "name": "get_articles",
              "definition": {
                "function": {
                  "name": "fetch_articles",
                  "schema": "public"
                },
                "table_argument": "author_row"
              }
            }
          ],
          "insert_permissions": [
            {
              "role": "student",
              "permission": {
                "check": {
                  "bio": {
                    "_is_null": false
                  }
                }
              }
            },
            {
              "role": "user",
              "permission": {
                "check": {
                  "_and": [
                    {
                      "id": "X-HASURA-USER-ID"
                    },
                    {
                      "is_registered": false
                    }
                  ]
                }
              }
            }
          ],
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "name",
                  "is_registered"
                ],
                "filter": {
                  "id": "X-HASURA-USER-ID"
                }
              }
            }
          ],
          "update_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": "*",
                "filter": {
                  "_and": [
                    {
                      "id": "X-HASURA-USER-ID"
                    },
                    {
                      "is_registered": false
                    }
                  ]
                },
                "check": null
              }
            }
          ]
        },
        {
          "table": {
            "name": "blog",
