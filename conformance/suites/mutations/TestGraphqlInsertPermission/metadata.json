          },
          "insert_permissions": [
            {
              "role": "user",
              "permission": {
                "check": {}
              }
            }
          ],
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": "*",
                "filter": {
                  "author_id": "X-Hasura-User-Id"
                }
              }
            }
          ],
          "update_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "title",
                  "content"
                ],
                "filter": {},
                "check": null,
                "set": {
                  "last_updated": "NOW()",
                  "updated_by": "X-Hasura-User-Id"
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "computer",
            "schema": "public"
          },
          "insert_permissions": [
            {
              "role": "developer",
