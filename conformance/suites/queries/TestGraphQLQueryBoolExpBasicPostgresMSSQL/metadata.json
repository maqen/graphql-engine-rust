{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "tables": [
        {
          "table": {
            "name": "account",
            "schema": "public"
          },
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "account_no"
                ],
                "filter": {
                  "_exists": {
                    "_table": {
                      "name": "user",
                      "schema": "public"
                    },
                    "_where": {
                      "id": "X-Hasura-User-Id",
                      "is_admin": true
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "article",
            "schema": "public"
          },
          "object_relationships": [
            {
              "name": "author",
              "using": {
                "foreign_key_constraint_on": "author_id"
              }
            }
          ],
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "author_id",
                  "content",
                  "id",
                  "title"
                ],
                "filter": {
                  "is_published": {
                    "_eq": true
                  }
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "author",
            "schema": "public"
          },
          "array_relationships": [
            {
              "name": "articles",
              "using": {
                "foreign_key_constraint_on": {
                  "column": "author_id",
                  "table": {
                    "name": "article",
                    "schema": "public"
                  }
                }
              }
            }
          ],
          "select_permissions": [
            {
              "role": "user",
              "permission": {
                "columns": [
                  "id",
                  "name"
                ],
                "filter": {}
              }
            }
          ]
        },
        {
          "table": {
            "name": "city",
            "schema": "public"
          }
        },
        {
          "table": {
            "name": "message",
            "schema": "public"
          },
          "object_relationships": [
            {
              "name": "parent",
              "using": {
                "foreign_key_constraint_on": "parent_id"
              }
            }
          ],
          "array_relationships": [
            {
              "name": "children",
              "using": {
                "foreign_key_constraint_on": {
                  "column": "parent_id",
                  "table": {
                    "name": "message",
                    "schema": "public"
                  }
                }
              }
            }
          ]
        },
        {
          "table": {
            "name": "orders",
            "schema": "public"
          }
        },
        {
          "table": {
            "name": "table_with_sql_identifier",
            "schema": "public"
          }
        },
        {
          "table": {
            "name": "user",
            "schema": "public"
          }
        },
        {
          "table": {
            "name": "uuid_test",
            "schema": "public"
          }
        }
      ],
      "configuration": {
        "connection_info": {
          "database_url": {
            "from_env": "HASURA_GRAPHQL_DATABASE_URL"
          },
          "isolation_level": "read-committed",
          "use_prepared_statements": false
        }
      }
    }
  ]
}
