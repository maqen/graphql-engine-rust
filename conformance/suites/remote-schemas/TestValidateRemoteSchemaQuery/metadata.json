{
  "version": 3,
  "sources": [
    {
      "name": "default",
      "kind": "postgres",
      "tables": [],
      "configuration": {
        "connection_info": {
          "database_url": {
            "from_env": "HASURA_GRAPHQL_DATABASE_URL"
          },
          "isolation_level": "read-committed",
          "use_prepared_statements": false
        }
      }
    }
  ],
  "remote_schemas": [
    {
      "name": "character-iface",
      "definition": {
        "url": "{{REMOTE_SCHEMAS_WEBHOOK_DOMAIN}}/character-iface-graphql"
      }
    },
    {
      "name": "union",
      "definition": {
        "url": "{{REMOTE_SCHEMAS_WEBHOOK_DOMAIN}}/union-graphql"
      }
    },
    {
      "name": "user",
      "definition": {
        "url": "{{REMOTE_SCHEMAS_WEBHOOK_DOMAIN}}/user-graphql"
      }
    }
  ]
}
